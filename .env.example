# Copiar este archivo a .env y ajustar los valores antes de levantar docker-compose.yml.
# .env NUNCA debe commitearse (ver .gitignore). Los valores de abajo son placeholders
# de ejemplo para desarrollo local, no secretos reales.

# --- PostgreSQL (compartido por db, keycloak y app) ---
POSTGRES_PASSWORD=changeme_local_db_password

# --- Keycloak admin console (KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD) ---
KEYCLOAK_ADMIN_PASSWORD=changeme_local_kc_admin_password

# --- Keycloak client secrets (deben coincidir con KeycloakAdminService / clients externos) ---
KEYCLOAK_EXTERNAL_CLIENT_SECRET=changeme_local_external_client_secret
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme_local_admin_client_secret

# --- Usuarios seed del realm (usados también por los tests E2E de Playwright) ---
SEED_ADMIN_PASSWORD=admin123
SEED_EMPLOYEE_PASSWORD=employee123

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=changeme_local_grafana_password
