{
  "info": {
    "_postman_id": "e1a6b4a0-8f2b-4b8b-9b1e-external-api-001",
    "name": "Sistema Gestion - External B2B API",
    "description": "Manual test flow for the external/M2M API (/api/external/v1/**). Run '01 - Auth' first to populate access_token and internal_access_token collection variables, then run the other folders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "keycloak_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "api_url", "value": "http://localhost:8081", "type": "string" },
    { "key": "realm", "value": "sistema-gestion", "type": "string" },
    { "key": "external_client_id", "value": "sistema-gestion-external-client", "type": "string" },
    { "key": "external_client_secret", "value": "external-dev-secret-change-me", "type": "string" },
    { "key": "internal_client_id", "value": "sistema-gestion-client", "type": "string" },
    { "key": "internal_username", "value": "employee", "type": "string" },
    { "key": "internal_password", "value": "employee123", "type": "string" },
    { "key": "product_id", "value": "1", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "internal_access_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Get External Token (Client Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.access_token).to.be.a('string');",
                  "pm.collectionVariables.set('access_token', body.access_token);",
                  "console.log('external access_token saved');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{external_client_id}}", "type": "text" },
                { "key": "client_secret", "value": "{{external_client_secret}}", "type": "text" }
              ]
            },
            "url": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "Get Internal Token (Employee - Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.access_token).to.be.a('string');",
                  "pm.collectionVariables.set('internal_access_token', body.access_token);",
                  "console.log('internal access_token saved');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{internal_client_id}}", "type": "text" },
                { "key": "username", "value": "{{internal_username}}", "type": "text" },
                { "key": "password", "value": "{{internal_password}}", "type": "text" }
              ]
            },
            "url": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "02 - External API - Happy Path",
      "item": [
        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has content array', () => pm.expect(pm.response.json().content).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/external/v1/products?page=0&size=20"
          }
        },
        {
          "name": "Get Product By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 404 (depends on seed data)', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/external/v1/products/{{product_id}}"
          }
        },
        {
          "name": "Low Stock Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/external/v1/products/low-stock?page=0&size=20"
          }
        },
        {
          "name": "Stock Movements By Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 404 (depends on seed data)', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('movement content has no userId field', () => {",
                  "    const body = pm.response.json();",
                  "    if (body.content.length > 0) {",
                  "      pm.expect(body.content[0]).to.not.have.property('userId');",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/external/v1/products/{{product_id}}/stock-movements?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "03 - Negative Tests",
      "item": [
        {
          "name": "Unauthenticated - List Products (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": "{{api_url}}/api/external/v1/products"
          }
        },
        {
          "name": "External Token On Internal Route (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/v1/products"
          }
        },
        {
          "name": "Internal Token On External Route (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{internal_access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/external/v1/products"
          }
        }
      ]
    },
    {
      "name": "04 - Rate Limit Probe (use Collection Runner)",
      "item": [
        {
          "name": "Low Stock (run 65x via Runner to trigger 429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Run this single request through Postman's Collection Runner",
                  "// (right-click the request/folder -> Run) with ~65 iterations and 0ms delay.",
                  "// First ~60 iterations within the same minute should be 200, then 429.",
                  "pm.test('status is 200 or 429', () => {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "  pm.test('429 body has rate_limit_exceeded error', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('rate_limit_exceeded');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": "{{api_url}}/api/external/v1/products/low-stock?page=0&size=1"
          }
        }
      ]
    }
  ]
}
